DATABASE_URL="file:./dev.db"

# --- Payments (optional) ---
# With no STRIPE_SECRET_KEY the site runs unchanged and the owner dashboard
# falls back to "email us to join". Use sk_test_… / whsec_… while developing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Price IDs from the Stripe dashboard (Products → each tier → two prices).
# All six must be set before checkout buttons appear.
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_SPOTLIGHT_MONTHLY=""
STRIPE_PRICE_SPOTLIGHT_ANNUAL=""

# Absolute URL used to build Stripe return links.
SITE_URL="https://www.truereview.me"

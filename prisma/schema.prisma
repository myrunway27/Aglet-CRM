generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())

  // The user's persistent pen name, shown on all their reviews instead of
  // any real identity. Assigned at signup; the user can re-roll or pick one.
  pseudonym String?

  emailVerifiedAt     DateTime?
  verifyCode          String?
  verifyCodeExpiresAt DateTime?
  verifyCodeIssuedAt  DateTime?

  sessions             Session[]
  reviews              Review[]
  helpfulVotes         HelpfulVote[]
  ownerClaims          OwnerClaim[]
  reports              Report[]
  notifications        Notification[]
  // True Review for Business membership. Replying publicly and inviting
  // customers are member features; claiming, editing and disputing stay free.
  // Null = not a member. Set manually by an admin until payments exist.
  proUntil             DateTime?
  // "starter" | "growth" | "spotlight" — meaningful only while proUntil is future
  proTier              String?
  // Stripe linkage. The customer is created on first checkout and reused, so
  // one person keeps one billing identity across upgrades and cancellations.
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?

  // The user's own dietary line, e.g. ",cholov-yisroel,celiac," — every
  // search and listing is filtered/annotated against it. See src/lib/diet.ts
  dietStandard String @default("")

  addedBusinesses Business[]        @relation("AddedBy")
  ownedBusinesses Business[]        @relation("OwnedBy")
  saves           Save[]
  lists           UserList[]
  confirmations   TagConfirmation[]
  reviewFlags     ReviewFlag[]
  sentInvites     ReviewInvite[]    @relation("SentInvites")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  message   String
  link      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Every outgoing email is recorded here. When SMTP isn't configured
// (local development), this doubles as the inbox: /admin/outbox.
model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  sentVia   String // "smtp" | "outbox"
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  category    String
  city        String
  description String @default("")
  // Comma-wrapped attribute slugs, e.g. ",kosher,vegan," — see src/lib/tags.ts
  tags        String @default("")

  // Location & contact, filled manually or via the OpenStreetMap lookup
  address      String    @default("")
  zip          String    @default("")
  phone        String    @default("")
  website      String    @default("")
  // Free-text opening hours, kept as a human-readable fallback/summary
  hours        String    @default("")
  // 1-4, shown as $ to $$$$; 0 = unknown
  priceLevel   Int       @default(0)
  // Contact email for the business itself (from the map lookup or whoever
  // added it). Used once, to tell the business it has been listed.
  contactEmail String    @default("")
  // Set when the listing notification has been sent, so it never repeats.
  notifiedAt   DateTime?

  // Kosher/halal certifying agency, e.g. "OU", "Star-K" — see src/lib/diet.ts
  certifier String @default("")
  lat       Float?
  lng       Float?

  // Cached scores, recomputed on review write — see src/lib/rating.ts
  scoreAvg       Float     @default(0)
  scoreCount     Int       @default(0)
  // Rank within (city, category) by score; 0 = not yet ranked
  cityRank       Int       @default(0)
  cityRankSize   Int       @default(0)
  // Frozen while a suspicious burst is under review
  // Denormalised from the newest counted review so search can sort and filter
  // on freshness without touching the reviews table.
  lastReviewedAt DateTime?
  scoreFrozen    Boolean   @default(false)
  scoreFrozenAt  DateTime?
  createdAt      DateTime  @default(now())

  addedById String?
  addedBy   User?   @relation("AddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  // Set when an owner claim is approved
  ownerId String?
  owner   User?   @relation("OwnedBy", fields: [ownerId], references: [id], onDelete: SetNull)

  reviews       Review[]
  claims        OwnerClaim[]
  openingHours  OpeningHour[]
  saves         Save[]
  listItems     ListItem[]
  confirmations TagConfirmation[]
  invites       ReviewInvite[]

  @@index([category])
  @@index([city])
  @@index([city, category])
  @@index([priceLevel])
}

// Structured opening hours: one row per day per span (handles split shifts).
// dayOfWeek 0 = Sunday. Minutes since midnight; closeMin > 1440 means the
// span runs past midnight into the next day.
model OpeningHour {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openMin    Int
  closeMin   Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
}

// A dietary claim confirmed (or disputed) by a visitor, so listings show
// "confirmed 3 months ago" instead of silently going stale.
model TagConfirmation {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  tag        String
  stillTrue  Boolean
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, tag])
  @@index([businessId, tag])
}

// "Want to go" / "Been there" — the low-commitment on-ramp before reviewing.
model Save {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  kind       String // "WANT" | "BEEN"
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId, kind])
  @@index([userId, kind])
}

// A titled, ordered, shareable collection. The unguessable slug is the
// share credential; lists are unlisted unless the owner publishes them.
model UserList {
  id        String   @id @default(cuid())
  slug      String   @unique
  userId    String
  title     String
  note      String   @default("")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]

  @@index([userId])
}

model ListItem {
  id         String @id @default(cuid())
  listId     String
  businessId String
  note       String @default("")
  position   Int    @default(0)

  list     UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([listId, businessId])
  @@index([listId, position])
}

// Review status:
//   PUBLISHED - live and clean
//   FLAGGED   - live, but tripped a fake-detection heuristic; in admin queue
//   HIDDEN    - removed from public view by an admin
model Review {
  id              String   @id @default(cuid())
  businessId      String
  userId          String
  // Half-star precision: 0.5 - 5.0
  rating          Float
  // "I love this place", independent of the score
  loved           Boolean  @default(false)
  // Comma-wrapped quick-tag slugs, e.g. ",huge-portions,loud," — src/lib/quicktags.ts
  quickTags       String   @default("")
  text            String
  // Random pen name shown publicly instead of any real identity
  pseudonym       String
  status          String   @default("PUBLISHED")
  flagReason      String?
  // Suspicious reviews stay visible but stop counting toward the score,
  // rather than being deleted (see /trust for the public explanation).
  // True when written after following an owner's invitation link. Shown to
  // readers as "Invited by the business" — context, never a trust badge, and
  // it has no effect on the score.
  viaInvite       Boolean  @default(false)
  includedInScore Boolean  @default(true)
  excludeReason   String?
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  photos       ReviewPhoto[]
  helpfulVotes HelpfulVote[]
  reports      Report[]
  ownerReply   OwnerReply?
  flags        ReviewFlag[]

  // Safeguard: one review per user per business
  @@unique([businessId, userId])
  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model ReviewPhoto {
  id       String @id @default(cuid())
  reviewId String
  // Path under /public, e.g. /uploads/abc.jpg
  path     String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model HelpfulVote {
  id       String @id @default(cuid())
  reviewId String
  userId   String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model OwnerReply {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// Claim status: PENDING | APPROVED | REJECTED
// Claim method:
//   EMAIL  - claimant proves control of an email at the business's own
//            domain via a one-time code; approved automatically
//   MANUAL - claimant submits free-text evidence; an admin decides
model OwnerClaim {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  evidence   String
  method     String   @default("MANUAL")
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  claimEmail          String?
  verifyCode          String?
  verifyCodeExpiresAt DateTime?
  verifyCodeIssuedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([status])
}

// An invitation an owner sent to a customer, asking for a review.
//
// Deliberately has no sentiment field and no way to target a subset: the FTC's
// 2024 rule bans "review gating" — soliciting only customers you expect to be
// happy — so an owner sends to a list and every recipient gets the same link.
model ReviewInvite {
  id         String    @id @default(cuid())
  businessId String
  ownerId    String
  email      String
  token      String    @unique
  sentAt     DateTime  @default(now())
  usedAt     DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  owner    User     @relation("SentInvites", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([businessId, sentAt])
  @@index([ownerId, sentAt])
}

// An owner disputing a review. Unlike Trustpilot, an unanswered dispute
// never deletes the review — it drops out of the score but stays readable.
// Status: OPEN | UPHELD (review excluded) | DISMISSED
model ReviewFlag {
  id        String   @id @default(cuid())
  reviewId  String
  ownerId   String
  evidence  String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([reviewId, ownerId])
  @@index([status])
}

// Report status: OPEN | REVIEW_HIDDEN | DISMISSED
model Report {
  id         String   @id @default(cuid())
  reviewId   String
  reporterId String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@index([status])
}

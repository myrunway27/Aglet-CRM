# Copy to .env.local (Next.js) and .env (Prisma CLI). Never commit real keys.

# PostgreSQL (docker compose up -d db). Optional: if unset, the app runs without
# persistence (no scan records, no stored-price fallback).
DATABASE_URL="postgresql://cardcompass:cardcompass@localhost:5432/cardcompass?schema=public"

# Catalog + price-reference provider: "mock" (bundled demo fixtures, no network)
# or "pokemontcg" (Pokémon TCG API v2, https://docs.pokemontcg.io).
CATALOG_PROVIDER=mock
# Server-side only. Optional: keyless access has lower documented limits.
POKEMONTCG_API_KEY=
POKEMONTCG_BASE_URL=https://api.pokemontcg.io/v2
# Documented limits as of 28 Sep 2026 — recheck before launch.
# Keyed: 20000/day, 30/min. Keyless: 1000/day, 30/min.
POKEMONTCG_LIMIT_PER_MINUTE=30
POKEMONTCG_LIMIT_PER_DAY=
POKEMONTCG_TIMEOUT_MS=8000
# Cache TTLs (seconds)
CATALOG_CACHE_TTL_SECONDS=86400
PRICE_CACHE_TTL_SECONDS=21600
# A reference older than this is flagged as stale in the UI.
PRICE_STALE_AFTER_DAYS=7

# OCR provider: "mock" (recognises bundled fixture images only) or "google"
# (Google Cloud Vision TEXT_DETECTION via REST, API-key auth).
OCR_PROVIDER=mock
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_CLOUD_VISION_TIMEOUT_MS=10000

# Upload limits
MAX_UPLOAD_BYTES=8000000
# Inbound scan rate limit per client IP (in-memory, per server instance)
SCAN_LIMIT_PER_MINUTE=20
# Sign-up attempts per IP per minute (login allows twice this per IP, and this many per email)
AUTH_LIMIT_PER_MINUTE=5

# Live listings: "none" (hidden), "mock" (labeled demo listings) or "ebay"
# (eBay Browse API, client-credentials; create keys at developer.ebay.com).
OFFERS_PROVIDER=mock
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplaces searched for every buyer (each costs one API call per search)
EBAY_MARKETPLACES=EBAY_US,EBAY_GB,EBAY_DE
EBAY_LIMIT_PER_DAY=5000
EBAY_LIMIT_PER_MINUTE=60
# Listings from sellers below these thresholds are shown but never ranked
EBAY_MIN_FEEDBACK_PCT=98
EBAY_MIN_FEEDBACK_SCORE=20

# Exchange rates: "mock" (labeled demo rates) or "ecb" (European Central Bank daily reference rates)
FX_PROVIDER=mock

# Scheduled job (POST /api/cron/run with "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email (confirmations, password resets, optional alert emails)
# Public base URL used in emailed links; never taken from request headers.
APP_URL=http://localhost:3000
# "outbox" writes emails to ./.outbox for local dev; "resend" sends via resend.com; "none" disables email.
MAIL_PROVIDER=outbox
MAIL_FROM="Card Compass <no-reply@example.com>"
RESEND_API_KEY=

# PriceCharting (paid API, sales-based prices incl. graded): "none", "mock" (labeled demo) or "live"
PRICECHARTING_PROVIDER=mock
PRICECHARTING_TOKEN=
PRICECHARTING_LIMIT_PER_MINUTE=30
PRICECHARTING_LIMIT_PER_DAY=5000

# PSA cert lookup (PSA public API bearer token): "none", "mock" (demo certs 90000001-90000004) or "live"
PSA_PROVIDER=mock
PSA_API_TOKEN=
PSA_LIMIT_PER_DAY=100

# Native app push (see docs/MOBILE.md). Android via Firebase Cloud Messaging service account:
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# iOS via APNs token auth (.p8 key):
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
# Capacitor build-time settings (used by `npx cap sync`, not by the server):
# CAP_SERVER_URL=https://app.yourdomain.com
# CAP_APP_ID=com.yourcompany.cardcompass
# eBay Marketplace Account Deletion (required for eBay production keys).
# Token: 32–80 chars of letters, digits, _ or - (e.g. `openssl rand -hex 24`).
# Endpoint defaults to $APP_URL/api/ebay/account-deletion; it must match the portal exactly.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=
# Shown on /privacy and /terms (those pages say "Draft" until both are set)
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=

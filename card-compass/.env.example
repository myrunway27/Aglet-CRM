# ---- Data sources -------------------------------------------------------
# "mock" (default) uses the bundled demo catalog: fictional sets, DEMO prices.
# "pokemontcg" uses the Pokémon TCG API v2 (https://docs.pokemontcg.io).
CATALOG_PROVIDER=mock
# Optional. Without a key the API allows fewer requests per day. Server-side only:
# never prefix with NEXT_PUBLIC_.
POKEMONTCG_API_KEY=
POKEMONTCG_BASE_URL=https://api.pokemontcg.io/v2
# Documented limits as of 28 Sep 2026; recheck before launch.
POKEMONTCG_LIMIT_PER_MINUTE=30
POKEMONTCG_LIMIT_PER_DAY_KEYED=20000
POKEMONTCG_LIMIT_PER_DAY_KEYLESS=1000

# ---- OCR ----------------------------------------------------------------
# "mock" (default) recognizes only the fixture images in fixtures/scans.
# "vision" uses Google Cloud Vision TEXT_DETECTION with Application Default
# Credentials (set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path,
# or run on GCP with an attached service account).
OCR_PROVIDER=mock
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# ---- Storage ------------------------------------------------------------
# Optional. When unset the app runs without persistence (in-memory cache only).
DATABASE_URL=postgresql://cardcompass:cardcompass@localhost:5432/cardcompass

# ---- Tuning -------------------------------------------------------------
CATALOG_CACHE_TTL_SECONDS=86400
PRICE_CACHE_TTL_SECONDS=21600
PRICE_STALE_AFTER_DAYS=7
UPLOAD_MAX_BYTES=8000000
OUTBOUND_TIMEOUT_MS=8000

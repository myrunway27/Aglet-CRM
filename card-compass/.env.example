# Copy to .env.local (Next.js) and .env (Prisma CLI). Never commit real keys.

# PostgreSQL (docker compose up -d db). Optional: if unset, the app runs without
# persistence (no scan records, no stored-price fallback).
DATABASE_URL="postgresql://cardcompass:cardcompass@localhost:5432/cardcompass?schema=public"

# Catalog + price-reference provider: "mock" (bundled demo fixtures, no network)
# or "pokemontcg" (Pokémon TCG API v2, https://docs.pokemontcg.io).
CATALOG_PROVIDER=mock
# Server-side only. Optional: keyless access has lower documented limits.
POKEMONTCG_API_KEY=
POKEMONTCG_BASE_URL=https://api.pokemontcg.io/v2
# Documented limits as of 28 Sep 2026 — recheck before launch.
# Keyed: 20000/day, 30/min. Keyless: 1000/day, 30/min.
POKEMONTCG_LIMIT_PER_MINUTE=30
POKEMONTCG_LIMIT_PER_DAY=
POKEMONTCG_TIMEOUT_MS=8000
# Cache TTLs (seconds)
CATALOG_CACHE_TTL_SECONDS=86400
PRICE_CACHE_TTL_SECONDS=21600
# A reference older than this is flagged as stale in the UI.
PRICE_STALE_AFTER_DAYS=7

# OCR provider: "mock" (recognises bundled fixture images only) or "google"
# (Google Cloud Vision TEXT_DETECTION via REST, API-key auth).
OCR_PROVIDER=mock
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_CLOUD_VISION_TIMEOUT_MS=10000

# Upload limits
MAX_UPLOAD_BYTES=8000000
# Inbound scan rate limit per client IP (in-memory, per server instance)
SCAN_LIMIT_PER_MINUTE=10
